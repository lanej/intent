{
  "version": "2",
  "run": {
    "timeout": "5m",
    "tests": true,
    "modules-download-mode": "readonly"
  },
  "linters": {
    "default": "none",
    "enable": [
      "govet",
      "ineffassign",
      "staticcheck",
      "unused",
      "asasalint",
      "asciicheck",
      "bidichk",
      "bodyclose",
      "contextcheck",
      "copyloopvar",
      "durationcheck",
      "errcheck",
      "errchkjson",
      "errorlint",
      "exhaustive",
      "fatcontext",
      "forcetypeassert",
      "gocheckcompilerdirectives",
      "gochecksumtype",
      "gosec",
      "loggercheck",
      "makezero",
      "nilerr",
      "nilnesserr",
      "noctx",
      "nolintlint",
      "nosprintfhostport",
      "predeclared",
      "reassign",
      "recvcheck",
      "rowserrcheck",
      "spancheck",
      "sqlclosecheck",
      "testifylint",
      "tparallel",
      "unconvert",
      "usetesting",
      "wastedassign",
      "wsl_v5",
      "zerologlint"
    ],
    "settings": {
      "errcheck": {
        "check-blank": true,
        "check-type-assertions": true,
        "disable-default-exclusions": true
      },
      "exhaustive": {
        "check": [
          "switch",
          "map"
        ],
        "default-signifies-exhaustive": false,
        "default-case-required": true
      },
      "gochecksumtype": {
        "default-signifies-exhaustive": false,
        "include-shared-interfaces": true
      },
      "govet": {
        "enable-all": true,
        "disable": [
          "fieldalignment"
        ]
      },
      "nolintlint": {
        "allow-unused": false,
        "require-explanation": true,
        "require-specific": true
      },
      "testifylint": {
        "enable-all": true
      },
      "wsl_v5": {
        "default": "default",
        "allow-first-in-block": true,
        "allow-whole-block": false,
        "branch-max-lines": 2,
        "case-max-lines": 0,
        "cuddle-max-statements": 1
      }
    },
    "exclusions": {
      "generated": "strict",
      "presets": [],
      "warn-unused": true
    },
    "disable": [
      "wsl"
    ]
  },
  "formatters": {
    "enable": [
      "gofmt",
      "goimports",
      "gofumpt"
    ],
    "settings": {
      "gofmt": {
        "simplify": true
      },
      "goimports": {
        "local-prefixes": [
          "github.com/lanej/intent"
        ]
      }
    },
    "exclusions": {
      "generated": "strict"
    }
  },
  "issues": {
    "max-issues-per-linter": 0,
    "max-same-issues": 0,
    "uniq-by-line": false
  }
}

